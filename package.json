{
  "name": "legacy-legion",
  "version": "1.0.0",
  "description": "Warhammer: The Old World Event Management System",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^0.20.5"
  },
  "build": {
    "appId": "com.legacy.legion",
    "productName": "Legacy Legion",
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "dist/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "dist/icon.icns"
    }
  }
}
